<h1>Search Shipments</h1>

<%= form_tag web_shipments_search_path, method: :get do %>
    <div>
        <%= label_tag :tracking_number %>
        <%= text_field_tag :tracking_number, params[:tracking_number] %> 
    </div>
    <div>
        <%= submit_tag "Search" %>
    </div>
<% end %>

<% if @shipments.present? %>
    <hr>
    <p>Tracking Number: <%= @shipments.tracking_number %></p>
    <p>Carrier Name: <%= @shipments.carrier_name %></p>
    <p>Status: <%= @shipments.status %></p>
<% elsif params[:tracking_number].present? %>
    <hr>
    <p>No se encontró ningún envío con ese número de seguimiento.</p>
<% end %>